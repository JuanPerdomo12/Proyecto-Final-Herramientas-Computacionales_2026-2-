    dccorr
# 21 "C:/Bruker/TOPSPIN2.1/exp/stan/nmr/lists/pp/p3919gp"
1 ze
# 1 "mc_line 21 file C:/Bruker/TOPSPIN2.1/exp/stan/nmr/lists/pp/p3919gp expanding definition of mc command after ze"
