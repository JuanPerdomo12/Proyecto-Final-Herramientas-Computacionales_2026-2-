# 1 "mc_line 21 file C:/Bruker/TOPSPIN2.1/exp/stan/nmr/lists/pp/p3919gp expanding definition part of mc command before ze"
define delay MCWRK
define delay MCREST
"MCWRK = 0.333333*30m"
